# Root Compose stack: builds the dashboard from source and runs bundled Nginx.
# For the published GHCR image, use deploy/.env.example instead.

# Production credentials (ADMIN_PASSWORD must be at least 12 characters;
# JWT_SECRET must be at least 32 characters). Generate unique values before use.
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Public URL of the dashboard (used in bootstrap commands)
DASHBOARD_URL=https://relay.example.com

# Path to Let's Encrypt certificates on the host
CERT_PATH=/etc/letsencrypt/live/relay.example.com
