# Dashboard environment
ADMIN_PASSWORD=changeme
JWT_SECRET=your-random-secret-here-at-least-32-chars
PORT=3000

# Public URL of the dashboard (used in bootstrap commands and agent WebSocket config)
# Set this to your actual domain when deploying behind nginx/HTTPS
# Examples: https://myserver.com, http://203.0.113.10:3000
# If not set, auto-detects from request Host header
DASHBOARD_URL=https://myserver.com
